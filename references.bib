  url      = {http://ezproxy.lib.indiana.edu/login?url=http://search.proquest.com/docview/622000615?accountid=11620
http://kg6ek7cq2b.search.serialssolutions.com/?ctx_ver=Z39.88-2004\&ctx_enc=info:ofi/enc:UTF-8\&rfr_id=info:sid/ProQ\&rft_val_fmt=info:ofi/fmt:kev:mtx:journal\&rft.genre=article\&rft.jtitle=Hormones+and+Behavior\&rft.atitle=Individual+differences+in+preschoolers\%27+salivary+cortisol+and+alpha-amylase+reactivity\%3A+Relations+to+temperament+and+maladjustment.\&rft.au=Spinrad\%2C+Tracy+L.\%3BEisenberg\%2C+Nancy\%3BGranger\%2C+Douglas+A.\%3BEggum\%2C+Natalie+D.\%3BSallquist\%2C+Julie\%3BHaugen\%2C+R.+G.\%3BKupfer\%2C+Anne\%3BHofer\%2C+Claire\&rft.date=2009-06-01\&rft.volume=56\&rft.issue=1\&rft.spage=133\&rft.isbn=\&rft.btitle=\&rft.title=Hormones+and+Behavior\&rft.issn=0018-506X
