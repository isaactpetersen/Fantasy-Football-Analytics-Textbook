@Article{Lantis2021,
  author   = {Lantis, Robert and Nesson, Erik},
  journal  = {Journal of Sports Economics},
  title    = {Hot shots: {An} analysis of the “hot hand” in {NBA} field goal and free throw shooting},
  year     = {2021},
  number   = {6},
  pages    = {639--677},
  volume   = {22},
  abstract = {We investigate the hot hand using detailed data on free throws and field goals attempts for 12 NBA seasons. We find a small hot hand for free throws, which more than doubles for longer streaks of made free throws. Both offenses and defenses respond to field goals, but a made field goal does not change the probability that a player makes his next field goal attempt, and longer streaks of made field goals reduce the probability that a player makes his next field goal attempt. Finally, a made field goal reduces the team’s expected points on their next shot.},
  doi      = {10.1177/15270025211006889},
  keywords = {hot hand, basketball, NBA},
  url      = {https://journals.sagepub.com/doi/abs/10.1177/15270025211006889},
}

@Article{Lantis2024,
  author   = {Lantis, Robert and Nesson, Erik},
  journal  = {Journal of Sports Economics},
  title    = {The hot hand in the {NBA} 3-point contest: {The} importance of location, location, location},
  year     = {2024},
  number   = {3},
  pages    = {283--321},
  volume   = {25},
  abstract = {We investigate the hot hand in the 1986-2019 NBA 3-Point Shooting Contests. Combining repeated shots in a location and shots across locations, the contest mimics game situations without many of the confounding factors. We find that a hot hand exists in the contest, but only for shots within the same location. Streaks of shots increase a hot hand, but only if the player makes his previous shot and has not moved locations. Our results suggest that while a hot hand does exist in basketball shooting, it is only present when shots are taken from the same shooting location.},
  doi      = {10.1177/15270025231222630},
  keywords = {hot hand, basketball, NBA, 3-Point Contest, D81, D91, Z20, Z29},
  url      = {https://journals.sagepub.com/doi/abs/10.1177/15270025231222630},
}

