@Article{Cudeck2002,
  author   = {Cudeck, Robert and du Toit, Stephen H. C.},
  journal  = {Multivariate Behavioral Research},
  title    = {A Version of Quadratic Regression with Interpretable Parameters},
  year     = {2002},
