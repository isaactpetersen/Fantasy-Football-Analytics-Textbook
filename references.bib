@Article{Ventura2013,
  author   = {Ventura, T. and Gomes, M. C. and Pita, A. and Neto, M. T. and Taylor, A.},
  journal  = {Early Human Development},
  title    = {Digit ratio (2D:4D) in newborns: Influences of prenatal testosterone and maternal environment},
