http://kg6ek7cq2b.search.serialssolutions.com/?ctx_ver=Z39.88-2004\&ctx_enc=info:ofi/enc:UTF-8\&rfr_id=info:sid/ProQ\%3Aabiglobal\&rft_val_fmt=info:ofi/fmt:kev:mtx:journal\&rft.genre=article\&rft.jtitle=Journal+of+Financial+Counseling+and+Planning\&rft.atitle=Sustainable+Withdrawal+Rates+From+Your+Retirement+Portfolio\&rft.au=Cooley\%2C+Philip+L\%3BHubbard\%2C+Carl+M\%3BWalz\%2C+Daniel+T\&rft.aulast=Cooley\&rft.aufirst=Philip\&rft.date=1999-01-01\&rft.volume=10\&rft.issue=1\&rft.spage=40\&rft.isbn=\&rft.btitle=\&rft.title=Journal+of+Financial+Counseling+and+Planning\&rft.issn=10523073\&rft_id=info:doi/
