  title   = {The neural correlates of inhibitory control in preschool children: Go/no-go task demands influence ERP amplitude and latency},
  year    = {2007},
  note    = {Paper 37},
  url     = {http://digitalcommons.unl.edu/dcnlfacpub/37/},
