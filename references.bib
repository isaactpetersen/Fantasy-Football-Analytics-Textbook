@Article{Rader2017,
  author   = {Rader, Christina A. and Larrick, Richard P. and Soll, Jack B.},
  journal  = {Social and Personality Psychology Compass},
  title    = {Advice as a form of social influence: Informational motives and the consequences for accuracy},
  year     = {2017},
  number   = {8},
  pages    = {e12329},
  volume   = {11},
  abstract = {Abstract In this article, we ask how well people fulfill informational motives by using the judgments of others. We build on advice-taking research from the judgment and decision making literature, which has developed a distinct paradigm to test how accurately people incorporate information from others. We use a literature review to show that people have mixed success in fulfilling informational motives—they increase their accuracy through the use of advice, but not as much as they could. We develop insights about how people perceive advisors and try to pursue advice—and where their perceptions may lead them astray. We conclude by proposing that future work further investigate the reasons people fail to use advice by building on the current advice taking paradigm used in judgment and decision making, but with a richer understanding of advice taking as a dynamic process that often entails complex decisions and normative motives.},
  doi      = {10.1111/spc3.12329},
  url      = {https://compass.onlinelibrary.wiley.com/doi/abs/10.1111/spc3.12329},
}

