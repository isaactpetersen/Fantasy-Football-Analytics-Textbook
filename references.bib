@Article{Galvan2013,
  author   = {Galván, Adriana},
  journal  = {Current Directions in Psychological Science},
  title    = {The Teenage Brain: Sensitivity to Rewards},
  year     = {2013},
  number   = {2},
  pages    = {88--93},
